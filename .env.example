# Copiar a .env y ajustar
POSTGRES_USER=agua
POSTGRES_PASSWORD=agua
POSTGRES_DB=agua_lluvia

# Clave única para acciones que modifican (aprobar alertas, /admin/*, reporte manual)
CLAVE_UNICA=cambiar-esta-clave

# LLM opcional; si está vacío, las alertas se redactan con plantillas
LLM_API_KEY=

# Push FCM: pega el JSON de la cuenta de servicio de Firebase en UNA línea.
# Si está vacío, los push se simulan (solo log) y la app usa GET /alerts/active.
FCM_CREDENCIALES_JSON=

# Carga las colonias/geometrías necesarias, pero nunca reportes ficticios.
AUTO_LOAD_REFERENCE_DATA=true
# Activar únicamente para una demo desechable.
AUTO_SEED=false
